            <Image url="@../images/indus-07.png" />
         </image>
      </ImageView>
      <ImageView fx:id="imgWitnessAi" fitHeight="388.0" fitWidth="354.0" layoutX="133.0" layoutY="166.0" onMouseClicked="#handleWitnessAiClick" preserveRatio="true">
