      <Button fx:id="btnNotGuilty" layoutX="748.0" layoutY="504.0" mnemonicParsing="false" onAction="#onChooseNotGuilty" prefHeight="70.0" prefWidth="165.0" text="NOT GUILTY" visible="false">
