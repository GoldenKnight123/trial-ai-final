            <Image url="@../images/logos-09.png" />
         </image>
      </ImageView>
      <ImageView fx:id="imgWitnessHuman" fitHeight="388.0" fitWidth="271.0" layoutX="930.0" layoutY="160.0" onMouseClicked="#handleWitnessHumanClick" preserveRatio="true">
