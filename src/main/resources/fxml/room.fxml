<Pane fx:id="room" focusTraversable="true" onMouseClicked="#handleGeneralClick" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFF8E3;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.RoomController">
   <children>
      <ImageView fx:id="imgTextArea1" fitHeight="720.0" fitWidth="1537.0" preserveRatio="true">
         <image>
            <Image url="@../images/background.png" />
         </image>
      </ImageView>
      <ImageView fx:id="imgDefendant" fitHeight="359.0" fitWidth="445.0" layoutX="477.0" layoutY="145.0" onMouseClicked="#handleDefendantClick" preserveRatio="true">
