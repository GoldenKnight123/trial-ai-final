      <Arc fx:id="arcTimer" layoutX="52.0" layoutY="49.0" length="360.0" opacity="0.25" radiusX="34.0" radiusY="35.0" startAngle="90.0" stroke="BLACK" strokeType="INSIDE" type="ROUND" />
