<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane fx:id="paneGameOver" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/verdict.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.GameOverController">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/game-over.png" />
         </image>
      </ImageView>
      <Button fx:id="btnRestart" alignment="CENTER" contentDisplay="CENTER" layoutX="586.0" layoutY="310.0" mnemonicParsing="false" onAction="#onRestart" stylesheets="@../css/verdict.css" text="Restart" textAlignment="CENTER" />
      <Label fx:id="lblGameOverMessage" alignment="CENTER" layoutX="51.0" layoutY="215.0" prefWidth="1200.0" text="Failed to interact with all participants.">
         <font>
            <Font size="36.0" />
         </font>
      </Label>
   </children>
</Pane>
